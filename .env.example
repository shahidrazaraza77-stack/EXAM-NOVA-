# ==============================================================================
# ExamNova - Production Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production.
# NEVER commit real secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Configuration (Accessible in client bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 2. Application Domain / Site URL (Crucial for OAuth redirects & CORS)
# - In local development: http://localhost:3000
# - In production: https://your-production-domain.com (or Vercel deployment URL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Supabase Server-Only Secret (Bypasses RLS for admin tasks & server auth)
# NEVER prefix with NEXT_PUBLIC_ — keep strictly server-side
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API Key (Server-Only Secret)
# Used for ATS Resume Parsing, AI Interview Coach, Job Matching, Roadmap Generation
# NEVER prefix with NEXT_PUBLIC_ — keep strictly server-side
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# 5. Google OAuth Credentials (Configured inside Supabase Dashboard > Auth > Providers)
# ------------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret
